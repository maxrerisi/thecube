// Copy to Secrets.xcconfig (gitignored). "//" starts a comment in .xcconfig files,
// so write URLs as  https:/$()/host  (the empty $() keeps the double slash).
// Simulator -> backend on this Mac:   http:/$()/localhost:8000
// Real phone -> deployed backend:     https:/$()/your-app.up.railway.app
API_BASE_URL = http:/$()/localhost:8000
APP_TOKEN = paste-APP_TOKEN-from-backend/.env
