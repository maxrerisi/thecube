// Copy to Secrets.xcconfig (gitignored). "//" starts a comment in .xcconfig files,
// so write URLs as  https:/$()/host  (the empty $() keeps the double slash).
// Simulator -> backend on this Mac:   http:/$()/localhost:8000
// Real phone -> deployed backend:     https:/$()/your-app.up.railway.app
API_BASE_URL = http:/$()/localhost:8000
APP_TOKEN = paste-APP_TOKEN-from-backend/.env
// Real phone: your team ID from Xcode > Settings > Accounts (free Apple ID works).
// DEVELOPMENT_TEAM = ABCDE12345
// Phone -> backend on this Mac (same Wi-Fi, uvicorn --host 0.0.0.0):  http:/$()/YOUR-MAC.local:8000
// Postmark inbound address shown in onboarding (forward receipts here).
// INBOUND_EMAIL = your-hash@inbound.postmarkapp.com
